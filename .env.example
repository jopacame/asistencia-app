# Puerto del servidor
PORT=3000

# Conexión a MongoDB Atlas (OBLIGATORIO para cloud)
# Crea una cuenta gratis en https://mongodb.com/atlas
MONGO_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/asistencia?retryWrites=true&w=majority

# Contraseña de administrador (opcional, por defecto: admin123)
ADMIN_PASSWORD=admin123
